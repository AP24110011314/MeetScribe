ENV=development
DATABASE_URL=postgresql+asyncpg://meet:meet@postgres:5432/meetscribe
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
S3_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=meetscribe
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
TRANSCRIBER=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIBE_LANGUAGE=
AUDIO_CHUNK_SECONDS=1800
# Only used when TRANSCRIBER=openai (install the extra: pip install ".[openai]").
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
WORKER_TEMP_DIR=/tmp/meetscribe
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
MAX_UPLOAD_MB=500
PIPELINE_MAX_RETRIES=3
STUCK_MEETING_MINUTES=60
CORS_ORIGINS=http://localhost:5173
