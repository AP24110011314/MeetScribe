# MeetScribe Backend Environment Configuration
# Copy this file to .env and fill in the required values

# Environment
ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://meet:meet@localhost:5432/meetscribe

# Redis (Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-key-that-is-at-least-32-bytes-long-for-testing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3 Storage (LocalStack for local development)
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=meetscribe
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Transcription
# Options: faster_whisper (local, default) or openai (OpenAI Whisper API)
TRANSCRIBER=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIBE_LANGUAGE=

# Audio processing
AUDIO_CHUNK_SECONDS=1800

# OpenAI Whisper API (optional, used when TRANSCRIBER=openai)
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# Worker temp directory
WORKER_TEMP_DIR=/tmp/meetscribe

# LLM Provider
# Options: anthropic (default) or openai
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Analysis settings
ANALYSIS_TOKEN_BUDGET=20000
MAP_WINDOW_SEC=600

# Upload limits
MAX_UPLOAD_MB=500

# Pipeline settings
PIPELINE_MAX_RETRIES=3
STUCK_MEETING_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173